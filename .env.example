# =============================================================================
# Mini Web Stack — unified environment variables
# =============================================================================
# Copy this file to .env and uncomment/edit values as needed.
# Individual module .env.example files remain the authoritative defaults.

# ---------------------------------------------------------------------------
# DNS Server
# ---------------------------------------------------------------------------

# DNS server network
DNS_BIND_HOST=0.0.0.0
# Use 5336 for local development without sudo. Use 53 on VPS/production DNS.
DNS_PORT=5336

# Static records
DNS_RECORDS_PATH=dns/dns_records.json
DNS_DEFAULT_TTL=5
DNS_RESOLVER_MODE=hybrid
DNS_FORWARD_TTL_SECONDS=60

# UDP limits
DNS_MAX_REQUEST_BYTES=1024
DNS_MAX_RESPONSE_BYTES=2048

# Per-client-IP rate limiting (sliding window)
DNS_RATE_LIMIT_MAX_QUERIES=10
DNS_RATE_LIMIT_WINDOW_SECONDS=1

# ---------------------------------------------------------------------------
# HTTP Server
# ---------------------------------------------------------------------------

# HTTP server network
HTTP_HOST=0.0.0.0
# Dev-friendly port (no sudo needed for <1024). Use 80 on production.
HTTP_PORT=8000
HTTP_BUFFER_SIZE=4096

# HTTPS port (code default; requires TLS setup to use)
HTTP_HTTPS_PORT=8443

# HTTP security headers
# HTTP_ENABLE_HSTS=false
# HTTP_HSTS_MAX_AGE=31536000
# HTTP_HSTS_INCLUDE_SUBDOMAINS=false
# HTTP_ENABLE_CSP=true
# HTTP_CSP_POLICY=default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'
# HTTP_ENABLE_WAF=true

# Static files
HTTP_PUBLIC_DIR=/absolute/path/to/web-stack/http-server/public

# Server identity
HTTP_SERVER_NAME=UIT-HTTP-Server/1.0

# Static file cache
HTTP_CACHE_MAX_SIZE=100
HTTP_CACHE_TTL=60

# Reverse proxy
# HTTP_PROXY_ROUTES_PATH=proxy_routes.json
# HTTP_PROXY_CONNECT_TIMEOUT=3.0
# HTTP_PROXY_READ_TIMEOUT=10.0
# HTTP_PROXY_BUFFER_SIZE=4096

# ---------------------------------------------------------------------------
# VPN Tunnel Server
# ---------------------------------------------------------------------------

# Application-layer Mini VPN tunnel. Use this with the WaterCat browser VPN
# toggle to route custom-loaded HTTP requests through a TCP tunnel.
VPN_BIND_HOST=0.0.0.0
VPN_PORT=9443
VPN_TOKEN=demo-token
VPN_CONNECT_TIMEOUT=5.0
VPN_READ_TIMEOUT=10.0
VPN_BUFFER_SIZE=4096
VPN_MAX_FRAME_BYTES=2097152
VPN_ALLOW_PRIVATE_TARGETS=true

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------

# Browser DNS connection
BROWSER_DNS_HOST=127.0.0.1
# Use 5336 for local development without sudo. Use 53 on VPS/production DNS.
BROWSER_DNS_PORT=5336
BROWSER_DNS_TIMEOUT=3.0
BROWSER_DNS_BUFFER=4096
BROWSER_ENABLE_DNS_CACHE=true
BROWSER_FORCE_CUSTOM_DNS_ALL_HOSTS=false
BROWSER_WEBENGINE_PROXY_HOST=127.0.0.1
BROWSER_WEBENGINE_PROXY_PORT=8899

# Browser HTTP client
# Dev-friendly port (no sudo needed for <1024). Use 80 on production.
BROWSER_HTTP_DEFAULT_PORT=8443
BROWSER_HTTP_TIMEOUT=5.0
BROWSER_HTTP_BUFFER=4096

# HTTPS default port (code default; 443 is standard HTTPS)
BROWSER_HTTPS_DEFAULT_PORT=443

# Browser Mini VPN tunnel
BROWSER_ENABLE_VPN=false
BROWSER_VPN_HOST=127.0.0.1
BROWSER_VPN_PORT=9443
BROWSER_VPN_TOKEN=demo-token
BROWSER_VPN_TIMEOUT=8.0
BROWSER_VPN_BUFFER=4096
BROWSER_VPN_MAX_FRAME_BYTES=2097152
BROWSER_VPN_MODE=all
BROWSER_VPN_DOMAINS=.local,localhost

# Browser UI/state
BROWSER_HOME_URL=internal:home
BROWSER_SEARCH_URL=internal:search?q={query}
BROWSER_ACCOUNT_BASE_URL=http://127.0.0.1:8443
BROWSER_THEME=light
BROWSER_FONT_SIZE=16
BROWSER_SEARCH_ENGINE=google
BROWSER_DEFAULT_BOOKMARKS=http://example.local/,http://example.local/about,http://test.local/
BROWSER_STATE_DIR=~/.mini_web_browser
# BROWSER_STATE_PATH=~/.mini_web_browser/browser_state.json

# Browser phishing detection
# BROWSER_ENABLE_PHISHING_DETECTION=true
# BROWSER_PHISHING_SUSPICIOUS_THRESHOLD=31
# BROWSER_PHISHING_BLOCK_THRESHOLD=61
# BROWSER_PHISHING_RULES_PATH=~/.mini_web_browser/phishing_rules.json

# Google Safe Browsing API key (primary phishing check; local heuristics fallback)
# BROWSER_GOOGLE_SAFE_BROWSING_API_KEY=

# Browser AI assistant (Gemini on Vertex AI)
BROWSER_ENABLE_AI_ASSISTANT=false
# BROWSER_AI_MODEL=gemini-2.5-flash
# BROWSER_AI_STREAM=true
# BROWSER_AI_TEMPERATURE=0.3
# BROWSER_AI_MAX_OUTPUT_TOKENS=1200
# BROWSER_AI_SELECTION_MAX_CHARS=8000
# BROWSER_AI_PAGE_TEXT_MAX_CHARS=24000
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
