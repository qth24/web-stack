# =============================================================================
# Mini Web Stack — unified environment variables
# =============================================================================
# Copy this file to .env and uncomment/edit values as needed.
# Individual module .env.example files remain the authoritative defaults.

# ---------------------------------------------------------------------------
# DNS Server
# ---------------------------------------------------------------------------

# DNS server network
DNS_BIND_HOST=0.0.0.0
# Use 5336 for local development without sudo. Use 53 on VPS/production DNS.
DNS_PORT=5336

# Static records
DNS_RECORDS_PATH=dns/dns_records.json
DNS_DEFAULT_TTL=5
DNS_RESOLVER_MODE=hybrid
DNS_FORWARD_TTL_SECONDS=60

# UDP limits
DNS_MAX_REQUEST_BYTES=1024
DNS_MAX_RESPONSE_BYTES=2048

# Per-client-IP rate limiting (sliding window)
DNS_RATE_LIMIT_MAX_QUERIES=10
DNS_RATE_LIMIT_WINDOW_SECONDS=10

# ---------------------------------------------------------------------------
# HTTP Server
# ---------------------------------------------------------------------------

# HTTP server network
HTTP_HOST=0.0.0.0
# Dev-friendly port (no sudo needed for <1024). Use 80 on production.
HTTP_PORT=8000
HTTP_BUFFER_SIZE=4096

# HTTPS port (code default; requires TLS setup to use)
HTTP_HTTPS_PORT=8443

# HTTP security headers
# HTTP_ENABLE_HSTS=false
# HTTP_HSTS_MAX_AGE=31536000
# HTTP_HSTS_INCLUDE_SUBDOMAINS=false
# HTTP_ENABLE_CSP=true
# HTTP_CSP_POLICY=default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'
# HTTP_ENABLE_WAF=true

# Static files
HTTP_PUBLIC_DIR=public

# Server identity
HTTP_SERVER_NAME=UIT-HTTP-Server/1.0

# Static file cache
HTTP_CACHE_MAX_SIZE=100
HTTP_CACHE_TTL=60

# Reverse proxy
# HTTP_PROXY_ROUTES_PATH=proxy_routes.json
# HTTP_PROXY_CONNECT_TIMEOUT=3.0
# HTTP_PROXY_READ_TIMEOUT=10.0
# HTTP_PROXY_BUFFER_SIZE=4096

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------

# Browser DNS connection
BROWSER_DNS_HOST=127.0.0.1
# Use 5336 for local development without sudo. Use 53 on VPS/production DNS.
BROWSER_DNS_PORT=5336
BROWSER_DNS_TIMEOUT=3.0
BROWSER_DNS_BUFFER=4096
BROWSER_ENABLE_DNS_CACHE=true
BROWSER_FORCE_CUSTOM_DNS_ALL_HOSTS=false

# Browser HTTP client
# Dev-friendly port (no sudo needed for <1024). Use 80 on production.
BROWSER_HTTP_DEFAULT_PORT=8000
BROWSER_HTTP_TIMEOUT=5.0
BROWSER_HTTP_BUFFER=4096

# HTTPS default port (code default; 443 is standard HTTPS)
BROWSER_HTTPS_DEFAULT_PORT=443

# Browser UI/state
BROWSER_HOME_URL=internal:home
BROWSER_SEARCH_URL=internal:search?q={query}
BROWSER_THEME=light
BROWSER_FONT_SIZE=16
BROWSER_SEARCH_ENGINE=google
BROWSER_DEFAULT_BOOKMARKS=http://example.local/,http://example.local/about,http://test.local/
BROWSER_STATE_DIR=~/.mini_web_browser
# BROWSER_STATE_PATH=~/.mini_web_browser/browser_state.json
